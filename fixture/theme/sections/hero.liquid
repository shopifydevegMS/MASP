<section class="hero">
  <h1>{{ section.settings.heading }}</h1>
  {% render 'shared-button', label: section.settings.button_label %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
